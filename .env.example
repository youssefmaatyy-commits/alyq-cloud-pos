# ALYQ Cloud POS — public build configuration (Vite embeds these in the client).
# Copy to .env, select a mode explicitly, and restart/rebuild after any change.
# Missing mode/configuration is an error, NEVER an automatic Demo fallback.

# Production includes real staging/preview backends. URL + public key required.
# For LOCAL evaluation only: change this to demo; the UI is visibly labelled
# DEMO / not for real transactions and stores synthetic data in this browser.
VITE_APP_MODE=production

# Exact HTTPS Supabase project origin (custom HTTPS domains supported).
# A legacy /rest/v1 suffix is normalized for compatibility; other paths,
# userinfo, query/fragment, HTTP and localhost URLs are rejected.
VITE_SUPABASE_URL=

# Public anon-role JWT or sb_publishable_ key ONLY. Never a privileged key.
# This public key is intentionally shipped; authorization still requires RLS.
VITE_SUPABASE_ANON_KEY=

# production | staging | preview; Demo builds are always identified as demo.
VITE_RELEASE_ENVIRONMENT=production

# Optional public P-256 VAPID application-server key, explicitly embedded by Vite.
WEB_PUSH_VAPID_PUBLIC_KEY=
# Web Push private configuration belongs only in Supabase Edge secret storage.

VITE_CURRENCY=EGP
# Empty opens the built-in public shop (#/store, with / aliasing the storefront).
# Use an approved HTTPS origin only when the shop has a separate public host.
VITE_STOREFRONT_URL=

# DEPRECATED compatibility veto, NOT a mode selector or tree-shaking promise.
# off + demo is rejected, off + production is allowed. Legacy on is accepted
# as a deprecated no-op, not a selector; every other nonempty value is rejected.
# Production ignores local seeds because it ONLY selects Supabase repositories.
# Migrate old deployments to VITE_APP_MODE=production (this may remain off).
# To evaluate Demo, explicitly select demo and REMOVE this line or leave empty.
VITE_DEMO_SEED=off

# Nonsecret identity. Full SHA is derived from git HEAD, never an arbitrary tag.
# An optional explicit SHA must match HEAD exactly; builtAt is generated in UTC.
VITE_APP_VERSION=6.0.0
VITE_BUILD_SHA=

# Promotion-only settings (GitHub protected environment, never browser VITE vars):
# ALLOW_EMPTY_STOREFRONT=false (true only with approval for new/staging stores)
# Vercel/GitHub credentials remain in their protected provider secret stores.
