# ═══════════════════════════════════════════════════════════════════════════
# ALYQ Cloud POS — environment template
#
# Copy to `.env` and fill in. Vite reads these at BUILD time and inlines them,
# so they must be present before `npm run build` (a running dev server picks
# them up on restart, not on hot reload).
#
#   cp .env.example .env
#
# VITE_APP_MODE is REQUIRED and there is no default. It names the artifact:
#
#   production  Live Supabase only. A missing, half-set, malformed or dangerous
#               Supabase configuration (plain http remote URL, service_role or
#               sb_secret_ key) FAILS THE BUILD, and a bundle that somehow
#               exists refuses to start. It never falls back to demo data.
#   demo        The deliberate in-browser dataset (localStorage, five seeded
#               accounts). Supabase values, if present, are ignored.
#
# An unset or empty value is a build failure — in every mode, including
# "nothing is configured". The previous release inferred the mode from the
# credentials, so a pipeline with a variable that never arrived shipped a demo
# artifact that looked like a live shop. Every existing deployment must set
# VITE_APP_MODE=production before its next rebuild; see
# docs/production/production-environment.md.
# ═══════════════════════════════════════════════════════════════════════════

# ── application mode (REQUIRED — production | demo) ───────────────────────
# Local development: demo is the convenient answer (this template ships it).
# Every deployment — Vercel, CI, desktop, a manual build — MUST set production.
# `npm run dev:demo` does the same thing without an .env file.
VITE_APP_MODE=demo

# ── Supabase (required for live mode) ─────────────────────────────────────
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Public anon key. This key is safe to ship to the browser — it only ever
# grants what row-level security allows (see supabase/migrations). NEVER put
# the service_role key here: it bypasses RLS entirely.
VITE_SUPABASE_ANON_KEY=

# Public P-256 VAPID application-server key for browser PushManager.subscribe().
# This exact value is intentionally embedded by vite.config.ts; it is not secret.
WEB_PUSH_VAPID_PUBLIC_KEY=

# Web Push server configuration belongs only in Supabase Edge Function secrets:
# WEB_PUSH_VAPID_PRIVATE_KEY and WEB_PUSH_SUBJECT. Never create VITE_* variants.

# ── presentation ──────────────────────────────────────────────────────────
# ISO-4217 code used for every amount the UI formats. Defaults to EGP.
VITE_CURRENCY=EGP

# ── storefront ────────────────────────────────────────────────────────────
# Where "Open website" on the POS register sends the cashier. Leave EMPTY (the
# default) to open the shop built into this bundle at #/store. That is internal
# navigation: it works in demo mode and live mode alike, needs no second host,
# and cannot be swallowed by a popup blocker.
#
# Set it ONLY when the shop is served from its own origin, e.g.
#   VITE_STOREFRONT_URL=https://shop.example.com
# It must be http(s) — any other scheme (javascript:, data:) is rejected at
# runtime, the built-in shop is opened instead, and the operator is told on
# screen. This value is not a secret and is inlined into the build.
VITE_STOREFRONT_URL=

# ── demo seed ─────────────────────────────────────────────────────────────
# "off" in every production build: the demo repositories must not seed a real
# installation. Leave unset while evaluating.
# VITE_DEMO_SEED=off

# ── release identity (client-safe, embedded at build time) ────────────────
# VITE_APP_VERSION and VITE_BUILD_SHA come from the frozen release
# manifest/commit in controlled CI; set both there. When they are absent the
# build reads the version from package.json and the commit from Git, and marks
# a dirty worktree (…-dirty) rather than pretending to be a release.
# VITE_BUILD_TIME is stamped by the build; set it only to reproduce a build.
VITE_APP_VERSION=6.0.0
VITE_BUILD_SHA=
