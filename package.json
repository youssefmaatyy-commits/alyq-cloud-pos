{
  "name": "alyq-cloud-pos",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.logic.mjs",
    "test:bundle": "node scripts/lib/app-bundle.mjs",
    "test:e2e": "node scripts/test.e2e.mjs",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "db:check": "node scripts/migrations.check.mjs",
    "lint": "eslint .",
    "test:rendered": "node scripts/rendered.flow.mjs",
    "desktop:dev": "node scripts/desktop.dev.mjs",
    "desktop:build": "npm run build",
    "desktop:package:dir": "npm run desktop:build && electron-builder --dir",
    "desktop:package:win": "npm run desktop:build && electron-builder --win nsis --x64",
    "desktop:package:win:unpacked": "npm run desktop:build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "3.4.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  },
  "description": "ALYQ Cloud POS web and Windows desktop application",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "eg.alyq.pos",
    "productName": "ALYQ POS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ALYQ-POS-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALYQ POS",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
